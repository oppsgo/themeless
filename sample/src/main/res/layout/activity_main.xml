<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mainTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/skin_panel_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/skin_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mainSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_shell_subtitle_placeholder"
                android:textColor="@color/skin_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            app:tint="@color/skin_accent" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/homeRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/skin_page_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnOpenFragmentDemo"
                style="@style/Widget.Themeless.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/main_entry_theme_title"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnOpenAppCompatDemo"
                style="@style/Widget.Themeless.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/main_entry_theme_appcompat_title"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnOpenVpStress"
                style="@style/Widget.Themeless.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/main_entry_vp_stress_title"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnOpenVp2Stress"
                style="@style/Widget.Themeless.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/main_entry_vp2_stress_title"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
