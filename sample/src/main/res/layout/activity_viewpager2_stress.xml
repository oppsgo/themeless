<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vp2StressRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/vp2StressTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/skin_panel_bg"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/vp2StressTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vp2_stress_title"
            android:textColor="@color/skin_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vp2StressSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vp2_stress_subtitle"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVp2Light"
                style="@style/Widget.Themeless.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/theme_demo_light"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnVp2Dark"
                style="@style/Widget.Themeless.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/theme_demo_dark"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnVp2Custom"
                style="@style/Widget.Themeless.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/theme_demo_custom"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vp2StressBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/vp2StressTabScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/skin_panel_bg"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/vp2StressTabBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/skin_divider" />

        <TextView
            android:id="@+id/vp2StressTabsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="@string/vp2_stress_section_tabs"
            android:textColor="@color/skin_text_secondary"
            android:textSize="12sp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp2StressPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/skin_page_bg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/skin_divider" />

        <TextView
            android:id="@+id/vp2StressBannerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="@string/vp2_stress_section_banner"
            android:textColor="@color/skin_text_secondary"
            android:textSize="12sp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp2StressBanner"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:overScrollMode="never" />
    </LinearLayout>
</LinearLayout>
