<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Themeless">
        <!-- 仅对 vivo 有效：拒绝 vivo 强制夜色。魅族「强制暗色」名单不读这两项。 -->
        <meta-data
            android:name="android.vivo_nightmode_support"
            android:value="false" />
        <meta-data
            android:name="android.vivo_invert_splash"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".demo.ThemeDemoActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".demo.ThemeAppCompatDemoActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Themeless" />
    </application>
</manifest>
