<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settingsTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/skin_panel_bg"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_settings"
            android:textColor="@color/skin_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <include
        layout="@layout/fragment_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
