<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demoListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_panel_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/demoListSubTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/skin_panel_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/demoListSubRv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/demo_list_sub_rv"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/demoListSubLv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/demo_list_sub_lv"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/demoListSubGv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/demo_list_sub_gv"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/demoListHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:text="@string/theme_demo_list_hint"
        android:textColor="@color/skin_text_secondary"
        android:textSize="12sp" />

    <!-- 包住内层 VP2，避免左右滑时被外层 demoPager 抢走 -->
    <io.github.oppsgo.themeless.demo.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/demoListPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </io.github.oppsgo.themeless.demo.NestedScrollableHost>
</LinearLayout>
