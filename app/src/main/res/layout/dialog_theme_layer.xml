<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/skin_panel_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/themeDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/skin_text_primary"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnThemeDialogAgain"
        style="@style/Widget.Themeless.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/skin_button_bg"
        android:text="@string/theme_demo_dialog_again"
        android:textColor="@color/skin_button_text" />
</LinearLayout>
