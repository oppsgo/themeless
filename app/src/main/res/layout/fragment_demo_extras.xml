<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demoExtrasRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_extras_hint"
            android:textColor="@color/skin_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/demo_extras_progress_title"
            android:textColor="@color/skin_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/demo_extras_progress_hint"
            android:textColor="@color/skin_text_secondary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/demoProgressHorizontal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="65"
            android:progressBackgroundTint="@color/skin_divider"
            android:progressTint="@color/skin_accent"
            android:secondaryProgress="80"
            android:secondaryProgressTint="@color/skin_text_secondary" />

        <ProgressBar
            android:id="@+id/demoProgressIndeterminate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/skin_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/demo_extras_seek_title"
            android:textColor="@color/skin_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/demo_extras_seek_hint"
            android:textColor="@color/skin_text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/demoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="40"
            android:progressBackgroundTint="@color/skin_divider"
            android:progressTint="@color/skin_accent"
            android:thumbTint="@color/skin_accent" />

        <TextView
            android:id="@+id/demoSeekValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
