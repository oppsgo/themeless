<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/themeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/themeTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/skin_panel_bg"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/themeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_demo_title"
            android:textColor="@color/skin_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/themeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/theme_demo_subtitle"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/themeBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/skin_page_bg"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/themeControlsScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/skin_page_bg"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_demo_custom_hint"
                    android:textColor="@color/skin_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnLight"
                    style="@style/Widget.Themeless.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/skin_button_bg"
                    android:backgroundTint="@null"
                    android:text="@string/theme_demo_light"
                    android:textColor="@color/skin_button_text"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnDark"
                    style="@style/Widget.Themeless.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/skin_button_bg"
                    android:backgroundTint="@null"
                    android:text="@string/theme_demo_dark"
                    android:textColor="@color/skin_button_text"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnCustom"
                    style="@style/Widget.Themeless.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/skin_button_bg"
                    android:backgroundTint="@null"
                    android:text="@string/theme_demo_custom"
                    android:textColor="@color/skin_button_text"
                    app:backgroundTint="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_demo_original"
                            android:textColor="@color/skin_text_secondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/themeOriginalIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:contentDescription="@string/theme_demo_original"
                            android:src="@drawable/mail_star_fill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_demo_resized"
                            android:textColor="@color/skin_text_secondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/themeSizedIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:contentDescription="@string/theme_demo_resized"
                            android:scaleType="fitXY" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/themeManagedLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/theme_demo_managed_sample"
                    android:textColor="@color/skin_text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnThemeDynamic"
                    style="@style/Widget.Themeless.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/skin_button_bg"
                    android:backgroundTint="@null"
                    android:text="@string/theme_demo_dynamic"
                    android:textColor="@color/skin_button_text"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnThemeUnmanaged"
                    style="@style/Widget.Themeless.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/skin_button_bg"
                    android:backgroundTint="@null"
                    android:text="@string/theme_demo_unmanaged"
                    android:textColor="@color/skin_button_text"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnThemeDialog"
                    style="@style/Widget.Themeless.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/skin_button_bg"
                    android:backgroundTint="@null"
                    android:text="@string/theme_demo_dialog"
                    android:textColor="@color/skin_button_text"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnThemePopup"
                    style="@style/Widget.Themeless.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/skin_button_bg"
                    android:backgroundTint="@null"
                    android:text="@string/theme_demo_popup"
                    android:textColor="@color/skin_button_text"
                    app:backgroundTint="@null" />

                <LinearLayout
                    android:id="@+id/themeExtraRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/skin_divider" />

        <LinearLayout
            android:id="@+id/themeListPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/skin_panel_bg"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="@string/theme_demo_list_hint"
                android:textColor="@color/skin_text_secondary"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/themeRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/skin_panel_bg"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
