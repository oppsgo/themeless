<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/themeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/themeTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/skin_panel_bg"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp">

        <TextView
            android:id="@+id/themeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_demo_title"
            android:textColor="@color/skin_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/themeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/theme_demo_subtitle"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/demoThemeActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLight"
                style="@style/Widget.Themeless.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/theme_demo_light"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnDark"
                style="@style/Widget.Themeless.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/theme_demo_dark"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCustom"
                style="@style/Widget.Themeless.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/skin_button_bg"
                android:backgroundTint="@null"
                android:text="@string/theme_demo_custom"
                android:textColor="@color/skin_button_text"
                app:backgroundTint="@null" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/demoTabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/skin_panel_bg"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/skin_accent"
            app:tabMode="fixed"
            app:tabRippleColor="@color/skin_accent"
            app:tabSelectedTextColor="@color/skin_accent"
            app:tabTextColor="@color/skin_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/skin_divider" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/demoPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/skin_page_bg" />
</LinearLayout>
